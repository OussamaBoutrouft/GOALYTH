# --- Database ---
DATABASE_URL=postgresql://postgres:goalyth_dev_pwd@localhost:5432/goalyth

# --- StatsBomb open data local clone (relative to project root) ---
OPEN_DATA_PATH=data/open-data/open-data-master

# --- StatsBomb attribution (OBLIGATOIRE dans l'UI quand des données SB sont affichées) ---
SHOW_STATSBOMB_ATTRIBUTION=true
STATSBOMB_ATTRIBUTION_TEXT="Data provided by StatsBomb"

# --- Ingestion ---
BATCH_SIZE=2000
LOG_EVERY_MATCH=true

# --- Providers payants avec clé gratuite ---
SPORTMONKS_API_KEY=
FOOTBALL_DATA_TOKEN=3005bb6551fb44a1965ec4d4c0229961
