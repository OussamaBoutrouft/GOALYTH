# --- Database ---
DATABASE_URL=postgresql://postgres:goalyth_dev_pwd@localhost:5432/goalyth

# --- Web / API ---
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Cache ---
REDIS_URL=redis://localhost:6379

# --- Auth (set in real environments, never commit secrets) ---
# AUTH_SECRET=
# AUTH_PROVIDER=

# --- AI (read-only analytics assistant) ---
# AI_PROVIDER=
# AI_API_KEY=
AI_DB_READONLY_URL=postgresql://goalyth_ai_readonly:change_me_ai_ro_pwd@localhost:5433/goalyth
AI_QUERY_TIMEOUT_MS=5000
AI_MAX_ROWS=200

# --- StatsBomb attribution (OBLIGATOIRE dans l'UI quand des données SB sont affichées) ---
SHOW_STATSBOMB_ATTRIBUTION=true
STATSBOMB_ATTRIBUTION_TEXT="Data provided by StatsBomb"

# --- StatsBomb open data local clone (relative to project root) ---
OPEN_DATA_PATH=data/open-data

# --- Ingestion (Python, voir ingestion/) ---
BATCH_SIZE=2000
LOG_EVERY_MATCH=true
THESPORTSDB_API_KEY=123
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
GOAL_API_KEY=
KICKOFF_API_KEY=
